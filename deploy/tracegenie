#!/usr/bin/env bash
set -euo pipefail
umask 077
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
command=${1:-help}
shift || true
read_key() { sed -n "s/^$1=//p" "${2:-.env}" | head -n 1; }
fail() { printf '%s\n' "$*" >&2; exit 1; }
prerequisites() {
  command -v docker >/dev/null || fail "Install Docker with Docker Compose first."
  docker compose version >/dev/null || fail "Docker Compose v2 is required."
  docker info >/dev/null 2>&1 || fail "Start Docker and ensure your user can access it."
}
dc() { docker compose --env-file .env -f compose.yaml "$@"; }
image_ready() {
  docker image inspect "$image" >/dev/null 2>&1 && return
  if [ -f image.tar.gz ]; then docker load -i image.tar.gz; else docker pull "$image"; fi
  docker image inspect "$image" >/dev/null || fail "The selected release image is unavailable."
}
require_config() {
  [ -f .env ] || fail "Run ./tracegenie install first."
  image=$(read_key COMMUNITY_IMAGE)
  [ -n "$image" ] || fail "Missing COMMUNITY_IMAGE in .env."
}
start() {
  dc up -d --wait --wait-timeout 180 postgres || return $?
  dc run --rm --no-deps migrate || return $?
  dc up -d --wait --wait-timeout 180 app worker gateway || return $?
  printf 'Ready: %s\n' "$(read_key PUBLIC_URL)"
}
backup() {
  mkdir -p backups
  stamp=$(date -u +%Y%m%dT%H%M%SZ)-$$
  temp="backups/.partial-$stamp"
  mkdir "$temp"
  dc stop app worker
  # A failed backup must not leave a previously running installation stopped.
  trap 'dc up -d app worker >/dev/null 2>&1 || true' EXIT
  dc exec -T postgres pg_dump -U community -d community --format=custom > "$temp/database.dump"
  dc run --rm --no-deps --user root --entrypoint tar app -C /data/uploads -cf - . > "$temp/uploads.tar"
  cp .env "$temp/.env"
  docker run --rm --network none --user "$(id -u):$(id -g)" -v "$PWD/$temp:/backup" "$image" node deploy/archive.mjs create /backup
  chmod -R go-rwx "$temp"
  mv "$temp" "backups/$stamp"
  trap - EXIT
  dc up -d --wait --wait-timeout 180 app worker
  printf 'Backup: %s/backups/%s\n' "$PWD" "$stamp"
}
case "$command" in
  help|--help|-h)
    cat <<'HELP'
TraceGenie Community
  ./tracegenie install [--url http://localhost:8088] [--name tracegenie-community] [--image IMAGE]
  ./tracegenie start | stop | status | logs | setup-code
  ./tracegenie backup
  ./tracegenie upgrade --image VERSIONED_IMAGE
  ./tracegenie restore BACKUP_DIRECTORY [--url URL] [--name NEW_NAME]
Install and restore use a new directory. Restore refuses an existing database.
Public installations require an HTTPS domain pointing at this server and ports 80/443.
Local installations bind to loopback. Data and settings survive stop and upgrade.
HELP
    ;;
  install|restore)
    prerequisites
    [ ! -e .env ] || fail "This directory already has an installation. Use start, or restore into a new directory."
    source_backup=""
    if [ "$command" = restore ]; then
      [ $# -gt 0 ] || fail "Supply a backup directory."
      source_backup=$(CDPATH= cd -- "$1" && pwd); shift
      [ -f "$source_backup/manifest.json" ] || fail "No backup manifest found."
    fi
    url=http://localhost:8088
    name=tracegenie-community
    image=tracegenie-community:local
    if [ -n "$source_backup" ]; then image=$(read_key COMMUNITY_IMAGE "$source_backup/.env"); fi
    while [ $# -gt 0 ]; do
      [ $# -ge 2 ] || fail "Option $1 needs a value."
      case "$1" in --url) url=$2;; --name) name=$2;; --image) image=$2;; *) fail "Unknown option: $1";; esac
      shift 2
    done
    image_ready
    if [ -n "$(docker volume ls -q --filter "label=com.docker.compose.project=$name")" ]; then
      fail "Installation name $name already owns Docker volumes. Use start in its directory, or choose a different --name."
    fi
    # Atomic configuration generation; an interrupted install can be retried with start.
    if [ "$command" = restore ]; then
      docker run --rm --network none --user "$(id -u):$(id -g)" -v "$source_backup:/backup:ro" "$image" node deploy/archive.mjs verify /backup
      docker run --rm --network none -i "$image" node deploy/configure.mjs "$url" "$name" "$image" restore < "$source_backup/.env" > .env.pending
    else
      docker run --rm --network none "$image" node deploy/configure.mjs "$url" "$name" "$image" > .env.pending
    fi
    mv .env.pending .env
    dc config --quiet
    if [ "$command" = restore ]; then
      dc up -d --wait --wait-timeout 180 postgres
      tables=$(dc exec -T postgres psql -U community -d community -Atc "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'")
      [ "$tables" = 0 ] || fail "Restore refused: this Docker installation name already has a database. Choose a new directory and --name."
      dc run --rm --no-deps --user root --entrypoint sh app -c 'test -z "$(ls -A /data/uploads)"' || fail "Restore refused: upload volume is not empty."
      dc exec -T postgres pg_restore -U community -d community --no-owner --no-acl --exit-on-error --single-transaction < "$source_backup/database.dump"
      dc run --rm --no-deps -T --user root --entrypoint tar app -C /data/uploads -xf - < "$source_backup/uploads.tar"
      dc run --rm --no-deps migrate
      dc run --rm --no-deps app node deploy/restore-origin.mjs "$(read_key PUBLIC_URL "$source_backup/.env")"
    fi
    start
    if [ "$command" = install ]; then
      printf 'Setup code (private, only works before the owner is created): %s\n' "$(read_key COMMUNITY_SETUP_TOKEN)"
      printf 'Open %s/setup to create your administrator account.\n' "$(read_key PUBLIC_URL)"
    fi
    ;;
  start|stop|status|logs|setup-code|backup|upgrade)
    prerequisites; require_config
    case "$command" in
      start) image_ready; start;;
      stop) dc stop;;
      status) dc ps;;
      logs) dc logs --tail 100 -f app worker gateway;;
      setup-code) printf '%s\n' "$(read_key COMMUNITY_SETUP_TOKEN)";;
      backup) backup;;
      upgrade)
        [ "${1:-}" = --image ] && [ -n "${2:-}" ] || fail "Use upgrade --image VERSIONED_IMAGE."
        candidate=$2
        case "$candidate" in *:latest|*:local) fail "Upgrade requires a versioned tag or digest.";; esac
        case "$candidate" in *@sha256:*|*:*) ;; *) fail "Upgrade requires an explicit version tag or digest.";; esac
        # Validate before pulling or touching the running installation.
        docker run --rm --network none "$image" node deploy/configure.mjs "$(read_key PUBLIC_URL)" "$(read_key COMPOSE_PROJECT_NAME)" "$candidate" >/dev/null
        docker image inspect "$candidate" >/dev/null 2>&1 || docker pull "$candidate"
        backup
        dc stop app worker
        cp .env .env.before-upgrade
        awk -v image="$candidate" '/^COMMUNITY_IMAGE=/{print "COMMUNITY_IMAGE=" image; next} {print}' .env > .env.pending
        mv .env.pending .env
        image=$candidate
        if ! start; then fail "Upgrade failed. Services may be unavailable. Keep the pre-upgrade backup and inspect ./tracegenie logs. Restore the backup into a new installation to recover."; fi
        ;;
    esac
    ;;
  *) fail "Unknown command. Run ./tracegenie help.";;
esac
