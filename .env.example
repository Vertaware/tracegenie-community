# npm run dev generates .env with unique local credentials.
# These are the settings for an operator-configured installation.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4310
API_BASE_URL=http://127.0.0.1:4310
ADMIN_APP_URL=http://127.0.0.1:4311
DEMO_APP_URL=http://127.0.0.1:4312
VITE_API_BASE_URL=http://127.0.0.1:4310
VITE_DEMO_APP_URL=http://127.0.0.1:4312
CORS_ORIGINS=http://127.0.0.1:4311,http://127.0.0.1:4312
PUBLIC_APP_ORIGINS=http://127.0.0.1:4312
TRUST_PROXY_HOPS=0
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.local/uploads
# Generated automatically by npm run setup/dev. For manual deployments, use 32 random bytes as 64 hex characters.
# Keep this key stable and back it up with the database. Never use a VITE_ variable.
# EMAIL_SETTINGS_ENCRYPTION_KEY=
# SMTP values are the fallback until configuration is saved in Settings > Email.
SMTP_HOST=127.0.0.1
SMTP_PORT=11325
SMTP_SECURE=false
# Set SMTP_USER and SMTP_PASSWORD when using an authenticated SMTP server.
# Resend: smtp.resend.com, port 465, SMTP_SECURE=true, SMTP_USER=resend,
# and SMTP_PASSWORD set to your own Resend API key. See README.md.
EMAIL_FROM=TraceGenie Community <notifications@community.test>
REQUESTER_EMAIL_FROM_EMAIL=notifications@community.test
REQUESTER_EMAIL_REPLY_TO=support@community.test
