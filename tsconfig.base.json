{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@tracegenie/shared": [
        "packages/shared/src/index.ts"
      ],
      "@tracegenie/shared/*": [
        "packages/shared/src/*"
      ],
      "@tracegenie/widget": [
        "packages/widget/src/index.ts"
      ],
      "@tracegenie/widget/*": [
        "packages/widget/src/*"
      ],
      "@vertaware/email": [
        "packages/email/src/index.ts"
      ],
      "@vertaware/email/*": [
        "packages/email/src/*"
      ]
    },
    "noUnusedLocals": true
  }
}
